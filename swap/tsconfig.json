{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["cli.ts", "server/**/*", "mcp/**/*", "hooks/**/*", "shared/**/*", "parser/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
